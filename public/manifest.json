{
  "manifest_version": 3,
  "name": "Wiky-Traders",
  "short_name": "Wiky-Traders",
  "version": "0.6.0",
  "description": "Copilote d'enchères pour WikiMasters : garde tes slots remplis selon tes règles et calcule le bon prix. C'est toi qui cliques.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Wiky-Traders – ouvrir la fenêtre sur WikiMasters",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wiki-traders@andyb31.github.io",
      "strict_min_version": "128.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "https://www.wiki-masters.com/*"
      ]
    }
  ]
}
